DIRECTUS_URL=https://directus.drperez86.com
DIRECTUS_TOKEN=<TOKEN_DE_LECTURA_ENDODB>
ENDODB_PUBLIC_URL=https://endodb.drperez86.com
ENDODB_RELEASE=local
# Alta de sedes (variables privadas del servidor):
ENDODB_ACCESS_TEAM_DOMAIN=https://<equipo>.cloudflareaccess.com
ENDODB_ACCESS_AUD=<audiencia-de-la-aplicacion-endodb>
ENDODB_SITE_ADMIN_EMAILS=<correo-administrador>
ENDODB_ORGANIZATION_ID=<uuid-de-bd_organizaciones>
ENDODB_SITE_WRITE_TOKEN=<token-directus-solo-crear-bd_sedes>

# Carga privada v4 (todas son variables del servidor; nunca NEXT_PUBLIC_):
ENDODB_N8N_URL=https://n8n.example.com/
ENDODB_WEBHOOK_SHARED_SECRET=<secreto-aleatorio-minimo-24-caracteres>
ENDODB_ACCESS_USER_MAP={"medico@example.com":"7a898b58-72db-49a5-a8a9-130456b78f03"}
ENDODB_OCR_LOCAL_ENDPOINT=http://ocr:8011/ocr
# Alternativa temporal y explícita para conservar v3 en paralelo. Omitida = v4.
# ENDODB_WEBHOOK_VERSION=v3
